{
  "name": "korea-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/sanitize-build-output.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "deploy:check": "node scripts/deploy-preflight.mjs",
    "deploy:stage": "npm run build && .venv/Scripts/python.exe -m pipeline.static_release --stage",
    "deploy": "node scripts/deploy-release.mjs",
    "cf:types": "wrangler types",
    "data": "python -m pipeline.cli"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "maplibre-gl": "6.10.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/suncalc": "1.9.2",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
